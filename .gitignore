.venv/

# Herramientas
.playwright-cli/
*.png

# Material de origen: la herramienta Excel de referencia, la norma, las
# fotometrias de fabricante y las corridas reales con nombres de vialidades de
# cliente. Nada de esto se versiona. Lo que el repo necesita de ese material ya
# esta derivado a texto: el VBA en reference/sead_vba/, los valores esperados
# en reference/casos_sead.json y las tablas de la norma en engine/nom.py.
# Las fotometrias .ies si se versionan, pero en catalogo/, que es de donde el
# motor las consume.
assets/


# Los estudios son trabajo: llevan geometria y a veces nombre de calle de un
# cliente concreto, y sus salidas son regenerables. Ninguno se versiona. El
# formato de entrada.json esta documentado en el README y en engine/cli.py, que
# es donde tiene que vivir para no depender de un caso de ejemplo.
estudios/


# La skill SI se versiona: es parte del producto, no configuracion. Lo que no
# es del proyecto son los permisos y ajustes que Claude Code escribe por
# maquina; ese archivo aparece solo la primera vez que se acepta un permiso.
.claude/settings.local.json
